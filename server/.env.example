# =============================================================================
# 章鱼智学 v2 — 环境变量模板
# 复制为 .env（与 settings.py 同级）并填入真实值
# =============================================================================

# ── Django 核心 ──────────────────────────────────────────────────────────────
# 生产环境：生成一个随机密钥 https://djecrety.ir/
SECRET_KEY=

# 生产环境设为 False
DEBUG=True

# 逗号分隔，生产环境如：.zhangyuzhixue.top,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS ─────────────────────────────────────────────────────────────────────
# 逗号分隔的允许跨域来源
CORS_ALLOWED_ORIGINS=http://localhost:8000

# ── Sentry ───────────────────────────────────────────────────────────────────
# 留空=不启用 Sentry
SENTRY_DSN=
# 采样率 0.0~1.0
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── PDF 签名密钥 ─────────────────────────────────────────────────────────────
# 生产环境务必修改为随机字符串
PDF_SECRET_KEY=dev-pdf-key-for-testing

# ── CSRF 信任来源 ─────────────────────────────────────────────────────────────
# 逗号分隔，默认 https://zhangyuzhixue.top
# CSRF_TRUSTED_ORIGINS=https://zhangyuzhixue.top

# ── 数据库（可选）─────────────────────────────────────────────────────────────
# 留空则使用 SQLite（默认 db.sqlite3）
# DB_NAME=db.sqlite3
# DATABASE_URL=postgres://user:***@host:5432/dbname
