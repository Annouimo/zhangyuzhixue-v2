#!/bin/bash
# Install as /opt/zhangyuzhixue-v2.git/hooks/post-receive.
# Only server/ is deployed so in-progress landing changes are not overwritten.

set -euo pipefail

DEPLOY_DIR="/opt/zhangyuzhixue-v2"
BARE_REPO="/opt/zhangyuzhixue-v2.git"
BACKUP_DIR="/var/backups/zhangyuzhixue-v2/pre-deploy"
SERVICE="zhangyuzhixue-web"
BRANCH="refs/heads/master"
DEPLOY_LOG="/var/log/zhangyuzhixue/deployments.log"
LOCK_FILE="/var/lock/zhangyuzhixue-deploy.lock"

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "Another production deployment is already running." >&2
    exit 1
fi

while read -r old_rev new_rev ref_name; do
    if [[ "$ref_name" != "$BRANCH" ]]; then
        echo "Ignoring $ref_name; production deploys master only."
        continue
    fi

    timestamp=$(date '+%Y%m%d-%H%M%S')
    backup_file="$BACKUP_DIR/db.$timestamp.sqlite3"
    shadow_dir="/tmp/zhangyuzhixue-shadow-$timestamp"
    mkdir -p "$BACKUP_DIR"
    "$DEPLOY_DIR/venv/bin/python" -c '
import sqlite3
import sys

source = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
target = sqlite3.connect(sys.argv[2])
with target:
    source.backup(target)
target.close()
source.close()
' "$DEPLOY_DIR/server/db.sqlite3" "$backup_file"
    gzip "$backup_file"
    echo "Database backup: $backup_file.gz"

    rollback() {
        exit_code=$?
        if [[ $exit_code -eq 0 ]]; then
            return
        fi
        trap - EXIT
        set +e
        echo "Deploy failed; restoring previous code and database."
        rm -rf "$shadow_dir"
        if [[ "$old_rev" != "0000000000000000000000000000000000000000" ]]; then
            cd "$DEPLOY_DIR"
            git --git-dir="$BARE_REPO" --work-tree="$DEPLOY_DIR" \
                checkout -f "$old_rev" -- server
            git --git-dir="$BARE_REPO" update-ref \
                "$ref_name" "$old_rev" "$new_rev"
        fi
        systemctl stop "$SERVICE"
        rm -f "$DEPLOY_DIR/server/db.sqlite3-wal" \
            "$DEPLOY_DIR/server/db.sqlite3-shm"
        gunzip -c "$backup_file.gz" > "$DEPLOY_DIR/server/db.sqlite3"
        chown -R ubuntu:ubuntu "$DEPLOY_DIR/server"
        systemctl restart "$SERVICE"
        exit "$exit_code"
    }
    trap rollback EXIT

    cd "$DEPLOY_DIR"
    if [[ "$old_rev" != "0000000000000000000000000000000000000000" ]]; then
        while IFS= read -r removed_path; do
            [[ "$removed_path" == server/* ]] || continue
            rm -rf -- "$DEPLOY_DIR/$removed_path"
        done < <(git --git-dir="$BARE_REPO" diff --name-only \
            --diff-filter=D "$old_rev" "$new_rev" -- server)
    fi
    git --git-dir="$BARE_REPO" --work-tree="$DEPLOY_DIR" \
        checkout -f "$new_rev" -- server
    cd "$DEPLOY_DIR/server"
    source ../venv/bin/activate
    pip install -q -r requirements.txt

    echo "Validating migrations against shadow database."
    rm -rf "$shadow_dir"
    mkdir -p "$shadow_dir"
    gunzip -c "$backup_file.gz" > "$shadow_dir/db.sqlite3"
    DB_NAME="$shadow_dir/db.sqlite3" python manage.py migrate --noinput
    python - "$shadow_dir/db.sqlite3" <<'PY'
import sqlite3
import sys

connection = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
integrity = connection.execute("PRAGMA integrity_check").fetchone()[0]
foreign_keys = connection.execute("PRAGMA foreign_key_check").fetchall()
connection.close()
if integrity != "ok" or foreign_keys:
    raise SystemExit(
        f"Shadow database validation failed: integrity={integrity}, "
        f"foreign_key_violations={len(foreign_keys)}"
    )
print("Shadow database validation passed.")
PY

    python manage.py migrate --noinput
    python - "$DEPLOY_DIR/server/db.sqlite3" <<'PY'
import sqlite3
import sys

connection = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
integrity = connection.execute("PRAGMA integrity_check").fetchone()[0]
foreign_keys = connection.execute("PRAGMA foreign_key_check").fetchall()
connection.close()
if integrity != "ok" or foreign_keys:
    raise SystemExit(
        f"Production database validation failed: integrity={integrity}, "
        f"foreign_key_violations={len(foreign_keys)}"
    )
print("Production database validation passed.")
PY
    python manage.py collectstatic --noinput
    chown -R ubuntu:ubuntu "$DEPLOY_DIR/server"
    systemctl restart "$SERVICE"

    for _ in {1..20}; do
        if curl -s -o /dev/null http://127.0.0.1:8001/admin/; then
            break
        fi
        sleep 1
    done
    systemctl is-active --quiet "$SERVICE"
    login_status=$(curl -s -o /dev/null -w '%{http_code}' \
        http://127.0.0.1:8001/api/v1/auth/login/)
    [[ "$login_status" == "405" ]]

    find "$BACKUP_DIR" -name 'db.*.sqlite3.gz' -mtime +30 -delete
    mkdir -p "$(dirname "$DEPLOY_LOG")"
    printf '%s old=%s new=%s backup=%s status=success\n' \
        "$(date --iso-8601=seconds)" "$old_rev" "$new_rev" \
        "$backup_file.gz" >> "$DEPLOY_LOG"
    rm -rf "$shadow_dir"
    trap - EXIT
    echo "Deployment completed: $new_rev"
done
