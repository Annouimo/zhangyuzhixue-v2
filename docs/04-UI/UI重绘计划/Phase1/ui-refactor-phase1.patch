+import 'package:flutter/material.dart';
+
+/// 应用图标语义映射。
+///
+/// 业务页面只表达图标含义，不自行混搭不同风格的图标。
+abstract final class AppIcons {
+  // 主导航
+  static const IconData home = Icons.home_outlined;
+  static const IconData homeSelected = Icons.home_rounded;
+  static const IconData recommendation = Icons.auto_awesome_outlined;
+  static const IconData recommendationSelected = Icons.auto_awesome_rounded;
+  static const IconData exam = Icons.description_outlined;
+  static const IconData examSelected = Icons.description_rounded;
+  static const IconData profile = Icons.person_outline_rounded;
+  static const IconData profileSelected = Icons.person_rounded;
+
+  // 通用操作
+  static const IconData back = Icons.arrow_back_rounded;
+  static const IconData close = Icons.close_rounded;
+  static const IconData more = Icons.more_horiz_rounded;
+  static const IconData search = Icons.search_rounded;
+  static const IconData filter = Icons.tune_rounded;
+  static const IconData refresh = Icons.refresh_rounded;
+  static const IconData add = Icons.add_rounded;
+  static const IconData edit = Icons.edit_outlined;
+  static const IconData delete = Icons.delete_outline_rounded;
+  static const IconData chevronRight = Icons.chevron_right_rounded;
+
+  // 产品语义
+  static const IconData success = Icons.check_circle_rounded;
+  static const IconData warning = Icons.warning_amber_rounded;
+  static const IconData error = Icons.error_rounded;
+  static const IconData info = Icons.info_outline_rounded;
+  static const IconData favorite = Icons.star_border_rounded;
+  static const IconData favoriteSelected = Icons.star_rounded;
+  static const IconData like = Icons.thumb_up_alt_outlined;
+  static const IconData likeSelected = Icons.thumb_up_alt_rounded;
+}
