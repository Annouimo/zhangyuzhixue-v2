+import 'package:flutter/material.dart';
+
+import '../theme/app_theme.dart';
+
+/// 状态标签的语义类型。
+enum AppStatusTone {
+  neutral,
+  primary,
+  info,
+  success,
+  warning,
+  error,
+  recommendation,
+}
+
+/// 统一的状态标签。
+///
+/// 标签同时使用文字、图标和颜色表达状态，避免只依赖颜色区分。
+class AppStatusBadge extends StatelessWidget {
+  const AppStatusBadge({
+    super.key,
+    required this.label,
+    this.tone = AppStatusTone.neutral,
+    this.icon,
+    this.compact = false,
+  });
+
+  final String label;
+  final AppStatusTone tone;
+  final IconData? icon;
+  final bool compact;
+
+  @override
+  Widget build(BuildContext context) {
+    final colors = context.colors;
+    final scheme = _resolveScheme(colors);
+    final resolvedIcon = icon ?? _defaultIcon;
+
+    return Semantics(
+      label: label,
+      child: DecoratedBox(
+        decoration: BoxDecoration(
+          color: scheme.background,
+          borderRadius: BorderRadius.circular(AppRadius.pill),
+          border: Border.all(color: scheme.border),
+        ),
+        child: Padding(
+          padding: EdgeInsets.symmetric(
+            horizontal: compact ? AppSpacing.xs : AppSpacing.sm,
+            vertical: compact ? AppSpacing.xxs : AppSpacing.xs,
+          ),
+          child: Row(
+            mainAxisSize: MainAxisSize.min,
+            children: [
+              if (resolvedIcon != null) ...[
+                Icon(
+                  resolvedIcon,
+                  size: compact ? 14 : 16,
+                  color: scheme.foreground,
+                ),
+                const SizedBox(width: AppSpacing.xxs),
+              ],
+              Text(
+                label,
+                style: Theme.of(context).textTheme.labelMedium?.copyWith(
+                      color: scheme.foreground,
+                      fontSize: compact ? 12 : null,
+                    ),
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+
+  IconData? get _defaultIcon => switch (tone) {
+        AppStatusTone.neutral => null,
+        AppStatusTone.primary => AppIcons.info,
+        AppStatusTone.info => AppIcons.info,
+        AppStatusTone.success => AppIcons.success,
+        AppStatusTone.warning => AppIcons.warning,
+        AppStatusTone.error => AppIcons.error,
+        AppStatusTone.recommendation => AppIcons.favoriteSelected,
+      };
+
+  _BadgeScheme _resolveScheme(AppSemanticColors colors) => switch (tone) {
+        AppStatusTone.neutral => _BadgeScheme(
+            background: colors.surfaceSubtle,
+            foreground: colors.textSecondary,
+            border: colors.border,
+          ),
+        AppStatusTone.primary => _BadgeScheme(
+            background: colors.primaryContainer,
+            foreground: colors.onPrimaryContainer,
+            border: colors.primaryBorder,
+          ),
+        AppStatusTone.info => _BadgeScheme(
+            background: colors.infoContainer,
+            foreground: colors.onInfoContainer,
+            border: colors.primaryBorder,
+          ),
+        AppStatusTone.success => _BadgeScheme(
+            background: colors.successContainer,
+            foreground: colors.onSuccessContainer,
+            border: colors.success,
+          ),
+        AppStatusTone.warning => _BadgeScheme(
+            background: colors.warningContainer,
+            foreground: colors.onWarningContainer,
+            border: colors.warning,
+          ),
+        AppStatusTone.error => _BadgeScheme(
+            background: colors.errorContainer,
+            foreground: colors.onErrorContainer,
+            border: colors.error,
+          ),
+        AppStatusTone.recommendation => _BadgeScheme(
+            background: colors.recommendationContainer,
+            foreground: colors.onRecommendationContainer,
+            border: colors.recommendation,
+          ),
+      };
+}
+
+class _BadgeScheme {
+  const _BadgeScheme({
+    required this.background,
+    required this.foreground,
+    required this.border,
+  });
+
+  final Color background;
+  final Color foreground;
+  final Color border;
+}
